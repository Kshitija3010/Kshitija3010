 "film": 106.931,
 "cues": [
  {
   "id": "L1",
   "t0": 0.45,
   "t1": 5.644,
   "text": "रोटी, हम रोज़ खाते हैं। पर दुनिया की पहली रोटी किसने बनाई?",
   "spoken": 4.634000000000001
  },
  {
   "id": "L2",
   "t0": 5.684,
   "t1": 9.843,
   "text": "ज़्यादातर लोग सोचते हैं, पहले खेती आई, फिर रोटी।",
   "spoken": 3.849
  },
  {
   "id": "L3",
   "t0": 9.883,
   "t1": 13.463,
   "text": "लेकिन सच, शायद इसका उल्टा है।",
   "spoken": 2.73
  },
  {
   "id": "L4a",
   "t0": 13.613,
   "t1": 17.104,
   "text": "चलिए, जॉर्डन के काले रेगिस्तान में,",
   "spoken": 3.2810135135135137
  },
  {
   "id": "L4b",
   "t0": 17.144,
   "t1": 21.4,
   "text": "शुबैक़ा नाम की जगह पर, 14,400 साल पहले।",
   "spoken": 3.6559864864864866
  },
  {
   "id": "L5a",
   "t0": 21.45,
   "t1": 25.634,
   "text": "यहाँ नातूफ़ी लोग रहते थे। वे खेती नहीं करते थे,",
   "spoken": 3.9743406593406596
  },
  {
   "id": "L5b",
   "t0": 25.674,
   "t1": 29.555,
   "text": "शिकार करते थे, और जंगली पौधे इकट्ठा करते थे।",
   "spoken": 3.720659340659341
  },
  {
   "id": "L6",
   "t0": 29.595,
   "t1": 34.02,
   "text": "उनकी पत्थर की झोपड़ी के बीच में था, एक चूल्हा।",
   "spoken": 3.575
  },
  {
   "id": "L7a",
   "t0": 34.17,
   "t1": 38.201,
   "text": "रोटी में थीं दो चीज़ें: जंगली गेहूँ, आइनकॉर्न,",
   "spoken": 3.821247058823529
  },
  {
   "id": "L7b",
   "t0": 38.241,
   "t1": 42.081,
   "text": "और पानी के किनारे उगने वाली घास के कंद।",
   "spoken": 3.2397529411764707
  },
  {
   "id": "L8",
   "t0": 42.231,
   "t1": 46.102,
   "text": "पहले, दानों को पत्थर पर पीसकर आटा बनाया।",
   "spoken": 3.561
  },
  {
   "id": "L9",
   "t0": 46.142,
   "t1": 48.935,
   "text": "फिर पानी मिलाकर, आटा गूँथा।",
   "spoken": 2.483
  },
  {
   "id": "L10",
   "t0": 48.975,
   "t1": 53.837,
   "text": "और उसे चूल्हे के गरम पत्थरों पर, या राख में सेंक दिया।",
   "spoken": 4.102
  },
  {
   "id": "L11",
   "t0": 53.877,
   "t1": 59.584,
   "text": "बिना ख़मीर की, पतली, चपटी रोटी। लगभग हमारी रोटी जैसी।",
   "spoken": 4.857
  },
  {
   "id": "L12a",
   "t0": 59.934,
   "t1": 62.892,
   "text": "हम ये कैसे जानते हैं? 2018 में,",
   "spoken": 2.748405063291139
  },
  {
   "id": "L12b",
   "t0": 62.932,
   "t1": 67.348,
   "text": "उसी चूल्हे में जली हुई रोटी के छोटे टुकड़े मिले।",
   "spoken": 4.255594936708861
  },
  {
   "id": "L13",
   "t0": 67.388,
   "t1": 73.253,
   "text": "माइक्रोस्कोप ने दिखाया, ये पीसकर, गूँथकर, सेंकी गई रोटी है।",
   "spoken": 5.015
  },
  {
   "id": "L14",
   "t0": 73.403,
   "t1": 76.317,
   "text": "और सबसे हैरानी की बात:",
   "spoken": 2.064
  },
  {
   "id": "L15",
   "t0": 76.567,
   "t1": 82.651,
   "text": "ये रोटी, खेती शुरू होने से कम से कम 4,000 साल पहले बनी थी।",
   "spoken": 5.234
  },
  {
   "id": "L16a",
   "t0": 82.701,
   "t1": 86.387,
   "text": "कुछ वैज्ञानिक सोचते हैं, शायद रोटी के लिए ही,",
   "spoken": 3.476385542168675
  },
  {
   "id": "L16b",
   "t0": 86.427,
   "t1": 89.963,
   "text": "इंसान ने बाद में अनाज उगाना शुरू किया।",
   "spoken": 2.9356144578313255
  },
  {
   "id": "L17",
   "t0": 90.513,
   "t1": 96.933,
   "text": "क्या आप 14,400 साल पुरानी रोटी चखना चाहेंगे? कमेंट में बताइए।",
   "spoken": 5.86
  },
  {
   "id": "L18a",
   "t0": 96.973,
   "t1": 100.773,
   "text": "अगले एपिसोड में, 4,500 साल पुरानी करी।",
   "spoken": 3.5901971830985917
  },
  {
   "id": "L18b",
   "t0": 100.813,
   "t1": 104.531,
   "text": "Kathaverse को फॉलो करना मत भूलिए!",
   "spoken": 3.1178028169014085
  }
 ]
}